# Copy to .env.prod locally, fill real values, then run scripts/deploy_vps.sh.
# Do not commit .env.prod.

DOMAIN=coach-ai.ru
ADMIN_EMAIL=admin@example.com

# Set to true only if you need Swagger /docs publicly. Off by default in prod.
ENABLE_DOCS=false

DB_USER=ai_trainer
DB_PASSWORD=replace-with-long-random-password
DB_NAME=ai_trainer

SECRET_KEY=replace-with-long-random-secret

AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MINI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=90

# EMAIL_PROVIDER: auto | brevo | resend | smtp
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_PROVIDER=auto

# Recommended on VPS: HTTPS email API. Verify sender/domain in provider first.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@coach-ai.ru
BREVO_SENDER_NAME=AI Trainer

RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@coach-ai.ru
RESEND_FROM_NAME=AI Trainer

# SMTP fallback. It may be blocked by VPS network policy.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=AI Trainer
SMTP_STARTTLS=true
SMTP_TLS_SERVER_HOSTNAME=
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Production Gmail SMTP workaround for VPS providers that filter IPv4 SMTP.
# docker-compose.prod.yml can run a host-network TCP proxy bound only to the
# Docker bridge gateway and forward to smtp.gmail.com over IPv6.
SMTP_PROXY_LISTEN_HOST=172.18.0.1
SMTP_PROXY_LISTEN_PORT=2525
SMTP_PROXY_TARGET_HOST=smtp.gmail.com
SMTP_PROXY_TARGET_PORT=587
SMTP_PROXY_TARGET_FAMILY=ipv6
