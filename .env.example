# === Backend ===
DATABASE_URL=postgresql+asyncpg://ai_trainer:ai_trainer@localhost:5432/ai_trainer
SECRET_KEY=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Email verification
EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_PROVIDER: auto | brevo | resend | smtp
EMAIL_PROVIDER=auto

# Recommended for VPS deploy: HTTPS email API, not SMTP.
# Brevo: verify sender/domain in Brevo, then set API key + sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@coach-ai.ru
BREVO_SENDER_NAME=AI Trainer

# Resend alternative: verify sender/domain in Resend, then set API key + sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@coach-ai.ru
RESEND_FROM_NAME=AI Trainer

# SMTP fallback. Some VPS providers block outbound SMTP ports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=AI Trainer
SMTP_STARTTLS=true
SMTP_TLS_SERVER_HOSTNAME=
SMTP_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Production Gmail SMTP workaround for VPS providers that filter IPv4 SMTP.
# docker-compose.prod.yml can run a host-network TCP proxy bound only to the
# Docker bridge gateway and forward to smtp.gmail.com over IPv6.
SMTP_PROXY_LISTEN_HOST=172.18.0.1
SMTP_PROXY_LISTEN_PORT=2525
SMTP_PROXY_TARGET_HOST=smtp.gmail.com
SMTP_PROXY_TARGET_PORT=587
SMTP_PROXY_TARGET_FAMILY=ipv6

# AI
AI_PROVIDER=auto
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MINI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=sk-ant-your-primary-key
ANTHROPIC_API_KEY_2=sk-ant-your-secondary-key
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=90

# Redis
REDIS_URL=redis://localhost:6379

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
